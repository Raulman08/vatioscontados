PUBLIC_SITE_NAME="Vatios Contados"
PUBLIC_SITE_DESCRIPTION="Cuánto consume cada electrodoméstico y cuánto te cuesta al mes, con el precio real de la luz de Red Eléctrica."

# Google Search Console — etiqueta de verificación HTML (Search Console > Añadir propiedad > método "Etiqueta HTML").
# Hay que regenerarla si se cambia de dominio (la verificación es por propiedad, no se copia entre dominios).
PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Amazon Afiliados — tag de tracking por región (sin guiones bajos, formato Amazon: midominio-21)
PUBLIC_AMAZON_TAG_ES=""
PUBLIC_AMAZON_TAG_US=""

# AdSense — client id (ca-pub-XXXXXXXXXXXXXXXX). Vacío = AdSense desactivado (regla de coste/riesgo cero hasta tener tráfico).
# Antes de activarlo: en la UE hace falta un gestor de consentimiento (CMP) certificado por Google.
# El de Google es gratis: AdSense > Privacidad y mensajes > Mensaje del RGPD. La política de cookies sola no basta.
PUBLIC_ADSENSE_CLIENT_ID=""
# Bloques manuales (AdSense > Anuncios > Por bloque de anuncios > Anuncio de display, adaptable). El id numérico de cada bloque:
# - CONTENIDO: se repite dentro del texto de guías informativas, pilares y medidas (máx. 3, uno cada ~350 palabras). Nunca en comparativas.
# - FINAL: uno al terminar cada guía (también en comparativas), antes de "Siguiente paso".
# Dejar DESACTIVADOS los "anuncios automáticos" en el panel de AdSense: ignorarían estas reglas de colocación.
# Con el cliente relleno, /ads.txt se genera solo. El aviso de cookies (CMP) se activa en AdSense > Privacidad y mensajes.
PUBLIC_ADSENSE_SLOT_CONTENIDO=""
PUBLIC_ADSENSE_SLOT_FINAL=""

# Ezoic — site id de verificación (dashboard Ezoic tras el alta). Vacío = Ezoic desactivado.
# No rellenar a la vez que PUBLIC_ADSENSE_CLIENT_ID: elegir uno para no competir por el mismo inventario de anuncios.
PUBLIC_EZOIC_SITE_ID=""
